{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/grants",
      "destination": "/"
    },
    {
      "source": "/awards",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "30 3 * * 1"
    },
    {
      "path": "/api/cron/grant-reminders",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/refresh.js": {
      "maxDuration": 60
    },
    "api/cron/grant-reminders.js": {
      "includeFiles": "index.html"
    },
    "api/grant-decision.js": {
      "includeFiles": "index.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
